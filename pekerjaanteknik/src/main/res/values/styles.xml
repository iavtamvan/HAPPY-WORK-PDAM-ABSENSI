<?xml version="1.0" encoding="utf-8"?>
<!--
    Gaya bersama modul Pekerjaan Teknik.
    Dipakai seluruh layar supaya kartu, tombol, kolom isian, dan tipografinya
    seragam dengan tampilan Home SPK. Ubah di sini, seluruh layar ikut berubah.
-->
<resources>

    <!-- ===================== Kartu ===================== -->
    <style name="PTCard">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/pdam_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ===================== Tipografi ===================== -->
    <!-- Judul layar atau bagian besar -->
    <style name="PTTitle">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/pdam_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Judul kecil di dalam kartu -->
    <style name="PTCardTitle">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/pdam_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Keterangan di atas/bawah nilai -->
    <style name="PTLabel">
        <item name="android:textColor">@color/pdam_text_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Isi data -->
    <style name="PTValue">
        <item name="android:textColor">@color/pdam_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PTValueStrong">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/pdam_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===================== Tombol ===================== -->
    <style name="PTButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/pdam_blue</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/white</item>
    </style>

    <style name="PTButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/pdam_blue_dark</item>
        <item name="strokeColor">@color/pdam_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="PTButtonDanger" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/pdam_warn_body</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Tombol kecil di dalam kartu, misal "Masukan ke daftar" -->
    <style name="PTButtonSmall" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/pdam_blue_dark</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- ===================== Kolom isian ===================== -->
    <style name="PTInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/pdam_blue</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="hintTextColor">@color/pdam_blue_dark</item>
        <item name="android:textColorHint">@color/pdam_text_muted</item>
    </style>

    <style name="PTInputText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/pdam_text</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- ===================== Penampil foto ===================== -->
    <!-- Tema dialog layar penuh (windowIsFloating=false). Induknya MaterialComponents
         supaya MaterialButton di dalamnya tidak menutup aplikasi. Warna status bar
         ditimpa karena bawaan tema gelap Material berwarna ungu. -->
    <style name="PTLihatFoto" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/pt_foto_latar</item>
        <item name="android:statusBarColor">@color/pt_foto_latar</item>
        <item name="android:navigationBarColor">@color/pt_foto_latar</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="colorPrimary">@color/pdam_blue</item>
        <item name="colorPrimaryVariant">@color/pdam_blue_dark</item>
        <item name="colorSecondary">@color/pdam_aqua</item>
    </style>

    <!-- Baris pilihan yang membuka layar lain (pengawas, zona, barang, tanggal) -->
    <style name="PTPickerRow">
        <item name="android:background">@drawable/bg_field_pdam</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

</resources>
