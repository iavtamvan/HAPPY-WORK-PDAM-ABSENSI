<?xml version="1.0" encoding="utf-8"?>
<!--
    Survey pelanggan (WebView). Id wajib: webview (WebView) dan 3 id content_headers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pdam_surface"
    android:orientation="vertical"
    tools:context="co.id.pdamkotasmg.pekerjaanteknik.activity.webView.WebViewActivity">

    <include layout="@layout/content_headers" />

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white" />

</LinearLayout>
