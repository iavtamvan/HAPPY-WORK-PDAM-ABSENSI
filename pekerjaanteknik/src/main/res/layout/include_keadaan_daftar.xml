<?xml version="1.0" encoding="utf-8"?>
<!--
    Tampilan kosong untuk layar daftar (Riwayat SPK, Riwayat Verifikasi, Verifikasi,
    Data Call Center, Riwayat Ambil Pekerjaan). Diletakkan di atas RecyclerView dalam
    satu FrameLayout dan dikendalikan oleh utils/KeadaanDaftar:
    kosong, tidak ditemukan (hasil pencarian), atau gagal dimuat (dengan "Coba lagi").
    Harus tetap gone di XML; KeadaanDaftar yang menampilkannya.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/div_keadaan_daftar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="32dp"
    android:paddingTop="16dp"
    android:paddingRight="32dp"
    android:paddingBottom="56dp"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="128dp"
        android:layout_height="128dp">

        <!-- Cincin riak: melebar lalu memudar, seperti tetes jatuh ke air -->
        <View
            android:id="@+id/v_keadaan_riak"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_cincin_riak_biru" />

        <FrameLayout
            android:id="@+id/div_keadaan_lingkar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_icon_soft_blue">

            <ImageView
                android:id="@+id/iv_keadaan_ikon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_pt_inbox"
                android:tint="@color/pdam_blue_dark" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tv_keadaan_judul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:textColor="@color/pdam_text"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Belum ada riwayat SPK" />

    <TextView
        android:id="@+id/tv_keadaan_pesan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/pdam_text_muted"
        android:textSize="13sp"
        tools:text="SPK yang Anda simpan akan muncul di sini." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_keadaan_aksi"
        style="@style/PTButtonOutlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:minWidth="150dp"
        android:visibility="gone"
        tools:text="Coba lagi" />
</LinearLayout>
