<?xml version="1.0" encoding="utf-8"?>
<!--
    Baris pilihan barang. Dipakai DUA adapter: BarangDikerjakanAdapter dan
    BarangTambahanAdapter.

    PENTING - tv_jenis_barang, tv_merek, dan tv_satuan berada di dalam blok
    yang sengaja disembunyikan. BarangTambahanAdapter MENULIS lalu MEMBACA
    kembali isi ketiganya untuk dikirim sebagai hasil pilihan. Kalau blok ini
    dihapus, data jenis/merek/satuan barang tambahan akan hilang diam-diam.
    Jadi: tetap ada di pohon layout, tetap visibility="gone".

    Id wajib: cv_klik (CardView), tv_kode_barang, tv_nama_barang,
    tv_jenis_barang, tv_merek, tv_satuan (semua TextView).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_klik"
    style="@style/PTCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/pdam_blue_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_kode_barang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_blue"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:maxWidth="96dp"
            android:minWidth="52dp"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:singleLine="true"
            android:textColor="@color/pdam_blue_dark"
            android:textSize="12sp"
            tools:text="99" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_nama_barang"
                style="@style/PTValueStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Nama barang" />

            <!-- Tiga blok pembawa data di bawah ini WAJIB tetap ada dan tetap gone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_jenis_barang"
                    style="@style/PTLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="jenis" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_merek"
                    style="@style/PTLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="merek" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_satuan"
                    style="@style/PTLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="satuan" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pt_chevron_right"
            android:tint="@color/pdam_text_muted" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
