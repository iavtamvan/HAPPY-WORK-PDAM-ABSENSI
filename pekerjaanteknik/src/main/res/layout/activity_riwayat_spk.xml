<?xml version="1.0" encoding="utf-8"?>
<!--
    Riwayat SPK. Id wajib: edt_search (EditText), rv (RecyclerView),
    btn_halaman_utama (Button, harus tetap gone karena Java yang menampilkan),
    adView, ditambah 3 id dari content_headers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pdam_surface"
    android:orientation="vertical"
    tools:context="co.id.pdamkotasmg.pekerjaanteknik.activity.spk.riwayat.RiwayatSpkActivity">

    <include layout="@layout/content_headers" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/bg_search_pdam"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pt_search"
            android:tint="@color/pdam_text_muted" />

        <EditText
            android:id="@+id/edt_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Cari No SPK"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/pdam_text"
            android:textColorHint="@color/pdam_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Daftar dan tampilan kosongnya (utils/KeadaanDaftar) dalam satu bingkai. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            tools:itemCount="4"
            tools:listitem="@layout/item_list_riwayat_spk" />

        <include layout="@layout/include_keadaan_daftar" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_halaman_utama"
        style="@style/PTButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        android:text="Halaman Utama"
        android:visibility="gone" />

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-6810772781589252/4208134634" />

</LinearLayout>
