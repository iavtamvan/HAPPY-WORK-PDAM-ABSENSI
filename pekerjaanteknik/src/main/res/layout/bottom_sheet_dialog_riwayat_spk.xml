<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom sheet "Update No CC" yang muncul saat baris Riwayat SPK diketuk.
    Dibuka RiwayatSPKAdapter.

    Id wajib: div_container, div_container_tutup_dialog_info_pendaftaran,
    edt_btm_nospk (EditText), edt_btm_nocc (EditText),
    btn_btm_update_nocc (Button), btn_btm_lihat_data (Button).

    Tinggi akar diubah dari match_parent menjadi wrap_content supaya formulir
    dua kolom ini tidak lagi memenuhi seluruh layar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:id="@+id/div_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="10dp"
        android:paddingRight="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_soft_blue"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_pt_copy"
                android:tint="@color/pdam_blue_dark" />

            <TextView
                style="@style/PTTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="Update No CC" />

            <!-- Tombol tutup. Listener dipasang di RiwayatSPKAdapter; sebelumnya
                 baris ini terlihat bisa ditekan padahal tidak melakukan apa pun. -->
            <LinearLayout
                android:id="@+id/div_container_tutup_dialog_info_pendaftaran"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_soft_blue"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pt_close"
                    android:tint="@color/pdam_text_muted" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/PTInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="No SPK">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_btm_nospk"
                style="@style/PTInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                tools:text="0020/BRT/PB/IV/2022" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/PTInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="No CC">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_btm_nocc"
                style="@style/PTInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_btm_update_nocc"
                style="@style/PTButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Update No CC" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_btm_lihat_data"
                style="@style/PTButtonOutlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="Lihat Data" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
