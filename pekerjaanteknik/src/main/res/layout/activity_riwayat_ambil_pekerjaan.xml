<?xml version="1.0" encoding="utf-8"?>
<!--
    Riwayat Ambil Pekerjaan. Id wajib: rv (RecyclerView) dan 3 id dari content_headers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pdam_surface"
    android:orientation="vertical"
    tools:context="co.id.pdamkotasmg.pekerjaanteknik.activity.spk.riwayat.RiwayatAmbilPekerjaanActivity">

    <include layout="@layout/content_headers" />

    <!-- Daftar dan tampilan kosongnya (utils/KeadaanDaftar) dalam satu bingkai. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:scrollbars="none"
            tools:itemCount="3"
            tools:listitem="@layout/item_list_perbaikan_cc" />

        <include layout="@layout/include_keadaan_daftar" />
    </FrameLayout>

</LinearLayout>
