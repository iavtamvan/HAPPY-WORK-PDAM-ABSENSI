<?xml version="1.0" encoding="utf-8"?>
<!--
    Baris pilihan zona. Dipakai ZonaAdapter.
    Id wajib: cv_klik (CardView), tv_kode_zona, tv_nama_zona, tv_jenis_zona (TextView).
    Dulu tiga kolom sama lebar rata tengah sehingga nama zona terpotong;
    sekarang nama zona jadi baris utama dan kode zona jadi penanda.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_klik"
    style="@style/PTCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/pdam_blue_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_kode_zona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_blue"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/pdam_blue_dark"
            android:textSize="12sp"
            tools:text="324234" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_nama_zona"
                style="@style/PTValueStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Gawangan" />

            <TextView
                android:id="@+id/tv_jenis_zona"
                style="@style/PTLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Jenis zona" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pt_chevron_right"
            android:tint="@color/pdam_text_muted" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
