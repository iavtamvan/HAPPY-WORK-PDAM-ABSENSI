<?xml version="1.0" encoding="utf-8"?>
<!--
    Baris pilihan pegawai (Pengawas / Kasub / Verifikator). Dipakai PengawasAdapter.
    Id wajib: cv_klik (CardView), tv_npp (TextView), tv_name_pegawai (TextView).
    Nama pegawai dinaikkan jadi informasi utama; NPP jadi penanda kecil,
    karena petugas mencari berdasarkan nama.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_klik"
    style="@style/PTCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/pdam_blue_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_soft_blue"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_pt_user"
            android:tint="@color/pdam_blue_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name_pegawai"
                style="@style/PTValueStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Nama Pegawai" />

            <TextView
                android:id="@+id/tv_npp"
                style="@style/PTLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="NPP 99348590347" />
        </LinearLayout>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pt_chevron_right"
            android:tint="@color/pdam_text_muted" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
