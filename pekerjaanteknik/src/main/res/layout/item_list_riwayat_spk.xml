<?xml version="1.0" encoding="utf-8"?>
<!--
    Baris daftar Riwayat SPK. Dipakai DUA adapter:
      - RiwayatSPKAdapter          (klik baris -> bottom sheet, div_copy menyalin No SPK)
      - RiwayatVerifikasiSPKAdapter(klik baris -> Detail SPK, div_copy tanpa aksi)

    Id wajib beserta jenisnya:
      cvKlik                      LinearLayout  (AKAR - kedua adapter meng-cast ke LinearLayout)
      cv_klik                     CardView      (tidak dibaca Java, hanya pembungkus visual)
      tv_list_item_type_pekerjaan TextView
      tv_no_spk                   TextView
      div_copy                    LinearLayout  (tombol salin)
      tv_tgl_spk_pelaksana        TextView
      tv_no_cc                    TextView
      tv_alamat                   TextView
      div_request_waiting         LinearLayout  (harus tetap gone)
      div_request_disetujui       LinearLayout  (harus tetap gone)
      tv_alamat_gps               TextView
      tv_uraian                   TextView
      tv_list_item_date           TextView
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvKlik"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_card_clickable"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_klik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Identitas utama: nomor SPK diletakkan paling menonjol karena
                 itulah yang dicari dan disalin petugas. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_soft_blue"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_pt_tool"
                    android:tint="@color/pdam_blue_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_no_spk"
                        style="@style/PTValueStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="0020/BRT/PB/IV/2022" />

                    <TextView
                        android:id="@+id/tv_list_item_type_pekerjaan"
                        style="@style/PTLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Perbaikan Pipa Bocor (PB)" />
                </LinearLayout>

                <!-- Tombol salin dibuat 40dp dan hanya selebar ikon. Sebelumnya
                     match_parent sehingga menelan sentuhan yang dimaksudkan
                     untuk membuka baris. -->
                <LinearLayout
                    android:id="@+id/div_copy"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_icon_soft_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pt_copy"
                        android:tint="@color/pdam_blue_dark" />
                </LinearLayout>
            </LinearLayout>

            <!-- Status verifikasi -->
            <LinearLayout
                android:id="@+id/div_request_waiting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_warn"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="12dp"
                android:paddingBottom="5dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pt_clock"
                    android:tint="@color/pdam_warn_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Menunggu"
                    android:textColor="@color/pdam_warn_title"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/div_request_disetujui"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_ok"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="12dp"
                android:paddingBottom="5dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pt_check_circle"
                    android:tint="@color/pdam_ok_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Terverifikasi"
                    android:textColor="@color/pdam_ok_title"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/pdam_outline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pt_calendar"
                    android:tint="@color/pdam_text_muted" />

                <TextView
                    android:id="@+id/tv_tgl_spk_pelaksana"
                    style="@style/PTValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    tools:text="Sen, 08 Apr 2022" />
            </LinearLayout>

            <TextView
                style="@style/PTLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Alamat Perbaikan"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_alamat"
                style="@style/PTValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                tools:text="Jl. Contoh No. 10" />

            <TextView
                style="@style/PTLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Alamat GPS"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_alamat_gps"
                style="@style/PTValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                tools:text="-6.98, 110.42" />

            <TextView
                style="@style/PTLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Uraian Pekerjaan"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_uraian"
                style="@style/PTValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                tools:text="Perbaikan pipa bocor" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/pdam_outline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/PTLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No CC"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_no_cc"
                        style="@style/PTValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="0426/CC/04/2022" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/PTLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dibuat"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_list_item_date"
                        style="@style/PTValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Kam, 07 Apr 2022 02:45:16" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
