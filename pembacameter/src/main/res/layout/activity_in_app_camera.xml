<?xml version="1.0" encoding="utf-8"?>
<!--
  In-App Camera Activity (CameraX).
  Layout: PreviewView fullscreen + bottom action bar.
  Watermark di-overlay subtle di pojok kanan-bawah preview (info-only),
  watermark final di-render saat capture (lihat InAppCameraActivity.captureWithWatermark).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Watermark overlay subtle di preview (info-only, tidak ke file) -->
    <TextView
        android:id="@+id/tv_watermark_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="120dp"
        android:alpha="0.55"
        android:background="#33000000"
        android:fontFamily="@font/poppins"
        android:lineSpacingExtra="-2dp"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="watermark"
        android:textColor="#FFFFFF"
        android:textSize="10sp" />

    <!-- Top bar: close + flash + switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tutup"
            android:padding="10dp"
            android:src="@drawable/arrrow_left"
            app:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_flash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Flash"
            android:padding="9dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_switch_camera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Switch kamera"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Bottom action bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="bottom"
        android:background="#CC000000">

        <ImageView
            android:id="@+id/btn_capture"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_camera_shutter"
            android:clickable="true"
            android:contentDescription="Ambil foto"
            android:focusable="true"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#C8102E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/poppins"
            android:text="Kamera dalam aplikasi"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress_capture"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFF"
        android:visibility="gone" />

</FrameLayout>
